#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Floor"
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 4, 5, 7, 6, 0, 1, 5, 4, 2, 3, 7, 6, 0, 2, 6, 4, 1, 3, 7, 5]
        point3f[] points = [
            (-256, -8, -256),
            (256, -8, -256),
            (-256, -8, 256),
            (256, -8, 256),
            (-256, 8, -256),
            (256, 8, -256),
            (-256, 8, 256),
            (256, 8, 256)
        ]
    }

    def Mesh "Pillar"
    {
        double3 xformOp:translate = (0, 64, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 4, 5, 7, 6, 0, 1, 5, 4, 2, 3, 7, 6, 0, 2, 6, 4, 1, 3, 7, 5]
        point3f[] points = [
            (-16, -64, -16),
            (16, -64, -16),
            (-16, -64, 16),
            (16, -64, 16),
            (-16, 64, -16),
            (16, 64, -16),
            (-16, 64, 16),
            (16, 64, 16)
        ]
    }

    def SphereLight "MainLight"
    {
        double3 xformOp:translate = (0, 200, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float inputs:intensity = 1.5
        color3f inputs:color = (1.0, 0.95, 0.85)
    }

    def Xform "info_player_deathmatch"
    {
        double3 xformOp:translate = (128, 24, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
